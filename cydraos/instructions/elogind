build['
mkdir build
cd    build

meson setup .. --prefix=/usr --buildtype=release -D man=auto -D docdir=/usr/share/doc/elogind-257.16 -D cgroup-controller=elogind -D dev-kvm-mode=0660 -D dbuspolicydir=/etc/dbus-1/system.d
ninja -j/#PROC#/
']

install['
ninja install
ln -sfv  libelogind.pc /usr/lib/pkgconfig/libsystemd.pc
ln -sfvn elogind /usr/include/systemd
']

dependency['
']

download['
https://github.com/elogind/elogind/archive/v257.16/elogind-257.16.tar.gz
